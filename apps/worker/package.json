{
  "name": "@workspace/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "dev": "wrangler dev --config wrangler.jsonc",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --config vitest.config.ts --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "catalog:",
    "zod": "catalog:",
    "@auth/core": "catalog:",
    "@hono/auth-js": "catalog:",
    "@workspace/contracts": "workspace:*",
    "@workspace/web": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "esbuild": "catalog:",
    "miniflare": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:"
  }
}
